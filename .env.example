# ============================================================================
# HEYGEN PLATFORM RECONSTRUCTION — ENVIRONMENT CONFIGURATION (.env.example)
# Copy to .env.local for local development or configure in Vercel / Worker host.
# Never commit real paid API credentials to source control.
# ============================================================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# Supabase PostgreSQL, Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Redis & BullMQ Background Job Queue
REDIS_URL=redis://localhost:6379

# AI Generation Providers (Leave blank to show truthful 'unconfigured' status for external APIs
# while using the operational Self-Hosted FFmpeg + Remotion engine)
HEYGEN_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Local Self-Hosted FFmpeg Binary Override (auto-detected from ffmpeg-static by default)
FFMPEG_STATIC_BIN=

# Stripe Billing & Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
